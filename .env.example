# ============================
# 应用基础配置
# ============================
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_NAME=问鼎铭校
APP_URL=https://localhost

# ============================
# 数据库配置（Docker Compose 中使用 service 名 db）
# ============================
DB_HOST=db
DB_PORT=5432
DB_NAME=qihang_banxue
DB_USER=postgres
DB_PASSWORD=change_me_to_a_strong_password

# ============================
# JWT 配置
# access_token 15-30 分钟，refresh_token 7-30 天
# ============================
JWT_SECRET=change_me_to_a_random_string_at_least_32_characters_long
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# ============================
# CORS 配置（生产环境必须指定具体域名，禁用通配符）
# ============================
CORS_ORIGIN=https://your-domain.com

# ============================
# 文件上传配置
# ============================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# ============================
# 日志配置
# ============================
LOG_LEVEL=info
LOG_PRETTY=false
